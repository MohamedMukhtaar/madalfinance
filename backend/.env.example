# ============================================================
# Server
# ============================================================
PORT=4000
NODE_ENV=development

# ============================================================
# Database (PostgreSQL 14+)
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
# Same password as the postgres role in pgAdmin (SCRAM). Empty will fail.
DB_PASSWORD=
DB_NAME=finance_system
DB_SCHEMA=public
DB_CONNECTION_LIMIT=10
# DB_SSL=false
# DB_LOGGING=false

# ============================================================
# JWT — use long random strings in production
# ============================================================
ACCESS_TOKEN_SECRET=change-me-access-secret-at-least-32-chars
REFRESH_TOKEN_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# ============================================================
# CORS — comma separated origins (no trailing slash)
# ============================================================
CLIENT_ORIGIN=http://localhost:5173

# ============================================================
# Email (Nodemailer). Leave SMTP_* empty to disable email.
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Madal ICT Solutions <no-reply@madal.local>

# ============================================================
# File uploads
# ============================================================
MAX_FILE_SIZE_MB=10

# ============================================================
# Schedule (cron) — defaults to daily housekeeping at 00:05
# ============================================================
# Nightly rental invoices — off by default; bill manually from Rental Billing page
RENTAL_AUTO_BILLING_ENABLED=false
RENTAL_BILLING_CRON=5 0 * * *
OVERDUE_CHECK_CRON=30 0 * * *
MONTHLY_DUES_CRON=0 1 1 * *
REPORT_CACHE_CRON=45 0 * * *
