# ============================================================
# Madal Finance Hub — root .gitignore (for GitHub)
# ============================================================

# --- Dependencies ---
node_modules/
**/node_modules/

# --- Build / output ---
dist/
build/
**/dist/
**/build/
*.tsbuildinfo
.vite/
coverage/
*.local

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example
!**/.env.example
backend/.env
frontend/.env

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend/src/logs/*.log
backend/logs/*

# --- Uploads & generated reports (keep folder placeholders) ---
backend/uploads/**
!backend/uploads/**/.gitkeep
backend/reports/**
!backend/reports/**/.gitkeep

# --- OS junk ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Editors / IDEs ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# --- Cursor / agent local ---
.cursor/
.cursorignore
agent-transcripts/

# --- Test / cache ---
.cache/
.turbo/
.eslintcache
.stylelintcache

# --- Misc ---
*.pem
*.key
*.p12
*.sqlite
*.db
tmp/
temp/
